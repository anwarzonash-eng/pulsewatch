# Copy to .env and run with: node --env-file=.env src/index.js
# All of these are optional and override pulsewatch.json.
PULSEWATCH_CONFIG=pulsewatch.json
PORT=3000
PULSEWATCH_DB=pulsewatch.db
PULSEWATCH_TITLE=My Status

# referenced from pulsewatch.json as "headers": { "Authorization": "Bearer ${HEALTH_TOKEN}" }
HEALTH_TOKEN=replace-me
